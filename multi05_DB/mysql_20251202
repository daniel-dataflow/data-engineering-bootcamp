-- 조건

실행순서 : from 테이블 -> where 조건 -> select 컬럼

select * from employees where hire_date >= '2000-01-01';

select * from salaries where salary >= 150000;

--월급이 100000 보다 크고 150000 보다 작거나 같은 모든 데이터

select * from salaries where salary > 100000 and salary <= 150000;

--1960년에 태어난 사원의 first_name 과 birth_date

select first_name, birth_date from employees where birth_date like '1960%' ;

select count(*) from employees where birth_date like '1960%' ;

-- 정렬 desc(내림차순) / asc(오름차순)

Select emp_no, salary from salaries order by salary limit 10; 

Select emp_no, salary from salaries order by salary desc limit 100; 

-- 늦게 취업한 순서대로 나이 순서대로

Select * from employees order by hire_date desc, birth_date limit 10;

-- 나이 순서대로 늦게 취업한 순서대로 

Select * from employees order by birth_date, hire_date desc limit 10;

