select * from join_a 

-- inner join : 같은 값이 있는 것만 나타내준다.

select * from join_a a inner join join_b b on a.ab = b.ab;

-- cross join : 모든 집합 : 잘 사용 안함

select * from join_a a inner join join_b b;

-- using 사용하면 내가 연결할려는 컬럼이 동일하다면 1개로만 나오게 된다.

select * from join_a a inner join join_b b using (ab);

-- 명시하지 않으면 기본적으로 inner로 사용된다.

select * from join_a a join join_b b on a.ab = b.ab;

select * from join_a a join join_b b using (ab);

-- 똑같은 컬럼이 있으면 자동으로 inner join을 해준다.

Select * from join_a natural join join_b;

-- outer join 

select * from join_a left outer join join_b on join_a.ab = join_b.ab;

select * from join_a left join join_b using(ab);

select * from join_a right outer join join_b on join_a.ab = join_b.ab;

select * from join_a right join join_b using(ab);

-- full outer join -> mysql 은 지원 x

select * from join_a full outer join join_b on join_a.ab = join_b.ab;

-- 집합연산 (union, union all)

