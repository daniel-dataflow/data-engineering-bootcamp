select dept_no, count(dept_no) from dept_emp group by dept_no;

-- 위 결과에서 사원의 수가 50000  이상인 부서만 

-- group by 에서 집계함수에 조건을 사용할 때는 where 대신 having!!!

select dept_no, count(dept_no) from dept_emp  group by dept_no having count(dept_no) >= 50000;

select max(salary), min(salary), avg(salary) from salaries;

--- employees 테이블에서 성이 s로 시작하면서 여자이면서 99년도 12월 에 입사한 사람의 전체 정보 출력

select * from employees where last_name like 'S%' and gender ='F' and hire_date like '1999-12%';

select * from employees where last_name like 'S%' and gender ='F' and year(hire_date) = 1999 and month(hire_date) =12;

-- employees 테이블에서 이름(first_name)에 'y'가 포함되거나, 이름이 'z'로 끝나는, 99년도에 입사한 사원의 전체정보

select * from employees where (first_name like '%y%' or first_name like '%z') and year(hire_date) = 1999;

-- title 테이블에서 직업 별 사원수를 출력하자. 단 사원수를 내림차순 정렬하자.

Select title, count(title) from titles group by title order by count(title) desc;

Select title, count(title) from titles where to_date ='9999-01-01' group by title order by count(title) desc;

-- distinct (별개의) : 고유값만 나오게 해준다.

Select distinct title from titles;

Select dayname(hire_date) from employees where hire_date='2000-01-28';

-- employees 테이블에서 성(last_name)과 이름(first_name)을 하나로 합칠건데. 사이에 공백 한개 넣어서 출력

Select last_name, first_name from employees limit 10;

Select last_name + " " + first_name from employees limit 10;

Select concat(last_name , " ", first_name) from employees limit 10;

-- 컬럼의 별칭

Select concat(last_name , " ", first_name) as full_name from employees limit 10;

-- dpartments 테이블에서 부서 이름(dept_name)을 모두 대문자로 출력

Select upper(dept_name) from departments;

-- employees 테이블에서 gender가 M이면 man,  F면 woman 으로 출력

Select gender, if (gender ='M', 'man', 'woman')  from employees limit 10;

-- salaries 테이블에서 5만 단위로 구간을 나눠서, 각 구간에 몇 명 씩 있는지 출력하자.

Select count(*), 

case 

when salary < 50000 then '1'

When salary < 100000 then '2'

When salary < 150000 then '3'

Else '4' 

End as salary_group

  from salaries

Group by salary_group

Order by salary_group;

-- 버리고 작은거

Select count(*), least(floor(salary/50000) + 1, 4) as salary_group

from salaries

Group by salary_group

Order by salary_group;

